# ── colossus-gateway memory layer ─────────────────────────────────────────
# Path to the colossus-gateway repo (for EnergyMemoryBridge import)
COLOSSUS_GATEWAY_PATH=../colossus-gateway

# ── Pinecone ───────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=colossus-apex
PINECONE_ENVIRONMENT=us-east-1
PINECONE_EMBED_DIM=1536

# ── Supermemory ────────────────────────────────────────────────────────────
SUPERMEMORY_API_KEY=
SUPERMEMORY_SPACE_OPS=
SUPERMEMORY_SPACE_SCENARIOS=
SUPERMEMORY_SPACE_LEGAL=
SUPERMEMORY_SPACE_DOCS=

# ── Supabase (existing) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Energy model ──────────────────────────────────────────────────────────
GRID_LIMIT_MW=1150
FEEDER_HEADROOM_MW_DEFAULT=80
WATER_RESTRICTION_GALLONS_HR=50000
